{
  "applicationId": "es.centaurux.mascota",
  "version": "0.1.0",
  "defaultMode": "window",
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": { "enabled": false, "writeToLogFile": false },
  "nativeAllowList": ["app.*", "window.*", "events.*", "os.getEnv", "filesystem.readFile", "filesystem.writeFile", "computer.*"],
  "modes": {
    "window": {
      "title": "Mascota de Claude",
      "width": 320,
      "height": 260,
      "minWidth": 320,
      "minHeight": 260,
      "resizable": false,
      "borderless": true,
      "transparent": true,
      "alwaysOnTop": true,
      "center": true,
      "useSavedState": true,
      "exitProcessOnClose": true,
      "enableInspector": false,
      "icon": "/resources/icon.png"
    }
  },
  "cli": {
    "binaryName": "mascota-claude",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "5.6.0",
    "clientVersion": "5.6.0"
  }
}
